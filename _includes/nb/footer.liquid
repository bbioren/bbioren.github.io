<footer class="sheet foot">
  <div class="track" id="track" title="hover the line">
    <svg viewBox="0 0 64 40" aria-hidden="true" id="bike">
      <g class="wheel" data-cx="14" data-cy="28">
        <circle class="ink" cx="14" cy="28" r="10" />
        <path class="spoke" d="M14 28 L14.00 18.00 M14 28 L21.07 20.93 M14 28 L24.00 28.00 M14 28 L21.07 35.07 M14 28 L14.00 38.00 M14 28 L6.93 35.07 M14 28 L4.00 28.00 M14 28 L6.93 20.93" />
      </g>
      <g class="wheel" data-cx="50" data-cy="28">
        <circle class="ink" cx="50" cy="28" r="10" />
        <path class="spoke" d="M50 28 L50.00 18.00 M50 28 L57.07 20.93 M50 28 L60.00 28.00 M50 28 L57.07 35.07 M50 28 L50.00 38.00 M50 28 L42.93 35.07 M50 28 L40.00 28.00 M50 28 L42.93 20.93" />
      </g>
      <path class="ink" d="M14 28 L26 14 L42 14 L50 28 M26 14 L32 28 L42 14 M32 28 L14 28 M24 9 L30 9 M42 14 L40 8 L46 8" />
    </svg>
  </div>
  <script src="{{ '/assets/notebook/bike.js' | relative_url | bust_file_cache }}" defer></script>
  <div class="links">
    <span>
      {% if site.data.socials.email -%}
        <a href="mailto:{{ site.data.socials.email }}">{{ site.data.socials.email }}</a> ·
      {%- endif %}
      {% if site.data.socials.github_username -%}
        <a href="https://github.com/{{ site.data.socials.github_username }}">github</a> ·
      {%- endif %}
      {% if site.data.socials.linkedin_username -%}
        <a href="https://www.linkedin.com/in/{{ site.data.socials.linkedin_username }}">linkedin</a>
      {%- endif %}
    </span>
    <span
      >© {{ 'now' | date: '%Y' }}
      {{ site.first_name }}
      {{ site.last_name -}}
    </span>
  </div>
</footer>
