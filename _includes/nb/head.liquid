<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
{% if page.url == '/' %}
  <title>
    {{ site.first_name }}
    {{ site.last_name }}
  </title>
{% else %}
  <title>
    {{ page.title }}
    ·
    {{ site.first_name }}
    {{ site.last_name }}
  </title>
{% endif %}
<meta
  name="description"
  content="{% if page.description %}{{ page.description | strip_html | escape }}{% else %}{{ site.first_name }} {{ site.last_name }}, UW computer science and math.{% endif %}"
>
<link rel="canonical" href="{{ page.url | absolute_url }}">
<link
  rel="icon"
  href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>{{ site.icon }}</text></svg>"
>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link
  rel="stylesheet"
  href="https://fonts.googleapis.com/css2?family=STIX+Two+Text:ital,wght@0,400;0,600;1,400;1,600&family=Caveat:wght@500;700&family=JetBrains+Mono:wght@400;600&display=swap"
>
<link rel="stylesheet" href="{{ '/assets/notebook/notebook.css' | relative_url | bust_file_cache }}">
{% if page.layout == 'post' or page.math %}
  <script>
    window.MathJax = {
      tex: { tags: 'ams', inlineMath: [['\\(', '\\)']], displayMath: [['\\[', '\\]']] },
      options: { skipHtmlTags: ['script', 'noscript', 'style', 'textarea', 'pre', 'code'] },
    };
  </script>
  <script defer src="https://cdn.jsdelivr.net/npm/mathjax@3.2.2/es5/tex-mml-chtml.js"></script>
{% endif %}
{% feed_meta %}
{% if jekyll.environment == 'production' %}
  <script data-goatcounter="https://bbioren.goatcounter.com/count" async src="//gc.zgo.at/count.js"></script>
{% endif %}
