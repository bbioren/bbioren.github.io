<header class="sheet">
  <nav class="nav" aria-label="Main">
    <a class="home" href="{{ '/' | relative_url }}">
      {{- site.first_name | downcase }}
      {{ site.last_name | downcase -}}
    </a>
    {% assign here = page.url %}
    {% assign items = 'about:/,research:/research/,sketchbook:/blog/,projects:/projects/,teaching:/teaching/,cv:/cv/' | split: ',' %}
    <ul>
      {% for it in items %}
        {% assign parts = it | split: ':' %}
        {% assign label = parts[0] %}
        {% assign path = parts[1] %}
        {% if path == '/' %}
          {% if here == '/' %}{% assign on = true %}{% else %}{% assign on = false %}{% endif %}
        {% else %}
          {% if here contains path %}{% assign on = true %}{% else %}{% assign on = false %}{% endif %}
        {% endif %}
        <li>
          <a
            href="{{ path | relative_url }}"
            {% if on %}
              aria-current="page"
            {% endif %}
          >
            {{- label -}}
          </a>
        </li>
      {% endfor %}
    </ul>
  </nav>
</header>
