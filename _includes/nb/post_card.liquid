{% assign p = include.post %}
<a class="sk" href="{{ p.url | relative_url }}">
  <span class="thumb">
    {% if p.thumbnail %}
      <img src="{{ p.thumbnail | relative_url }}" alt="" loading="lazy">
    {% else %}
      <svg viewBox="0 0 64 40" aria-hidden="true">
        <circle class="ink" cx="14" cy="28" r="10" /><circle class="ink" cx="50" cy="28" r="10" /><path class="ink" d="M14 28 L26 14 L42 14 L50 28 M26 14 L32 28 L42 14 M32 28 L14 28 M24 9 L30 9 M42 14 L40 8 L46 8" />
      </svg>
    {% endif %}
  </span>
  <span class="t">{{ p.title }}</span>
  <small>
    {{- p.date | date: '%b %Y' | downcase -}}
    {%- if p.kind %}
      · <span class="kind">{{ p.kind }}</span>
    {%- endif -%}
  </small>
</a>
