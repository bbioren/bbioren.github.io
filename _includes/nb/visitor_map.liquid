{% assign v = site.data.visitors %}
{% assign geo = site.data.country_points %}
{% if v and v.countries.size > 0 %}
  {% if v.simulated != true or jekyll.environment != 'production' %}
    <h2 class="label">Who's been reading</h2>
    <p class="hand" style="margin-top: -4px">
      a stamp for every country that's opened this notebook.
      {%- if v.simulated %}
        <span class="sim">(simulated data, only visible locally)</span>
      {%- endif %}
    </p>
    <style>
      {% for c in v.countries %}.world path[data-iso="{{ c.iso }}"]{fill:rgb(214 40 40 / {{ forloop.length | minus: forloop.index0 | times: 0.03 | plus: 0.08 }})}{% endfor %}
    </style>
    <div class="vmap">
      {% include nb/world_map.svg %}
      <svg class="stamps" viewBox="0 0 {{ geo.width }} {{ geo.height }}" aria-hidden="true">
        {% assign maxc = v.countries[0].count | times: 1.0 %}
        {% for c in v.countries %}
          {% assign pt = geo.countries[c.iso] %}
          {% if pt %}
            {% assign frac = c.count | divided_by: maxc %}
            {% assign r = frac | times: 9 | plus: 6 %}
            <g class="stamp-mark" transform="translate({{ pt.x }} {{ pt.y }}) rotate({{ forloop.index | times: 37 | modulo: 30 | minus: 15 }})">
              <circle r="{{ r }}" />
              <circle r="{{ r | minus: 3 }}" class="inner" />
              <title>{{ pt.name }}: {{ c.count }}</title>
            </g>
          {% endif %}
        {% endfor %}
      </svg>
    </div>
    <ol class="vtop mono">
      {% for c in v.countries limit: 5 %}
        {% assign pt = geo.countries[c.iso] %}
        <li>
          {{ pt.name | default: c.iso | downcase }}
          <span class="muted">{{ c.count }}</span>
        </li>
      {% endfor %}
    </ol>
    <p class="mono muted vfoot">{{ v.countries.size }} countries · updated {{ v.updated }}</p>
  {% endif %}
{% endif %}
