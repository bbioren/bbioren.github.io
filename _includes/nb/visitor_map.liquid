{% assign v = site.data.visitors %}
{% assign geo = site.data.country_points %}
{% assign dm = site.data.dot_map %}
{% if v and v.countries.size > 0 %}
  {% if jekyll.environment != 'production' or site.show_visitor_map == true and v.simulated != true %}
    {% assign maxc = v.countries[0].count | times: 1.0 %}
    <h2 class="label">Who's been reading</h2>
    <p class="hand" style="margin-top: -4px">
      every dot is a bit of the world, and the inked ones have opened this notebook.
      {%- if v.simulated %}
        <span class="sim">(simulated data, only visible locally)</span>
      {%- endif %}
    </p>

    <style>
      {% for c in v.countries %}
        {% assign share = c.count | divided_by: maxc %}
        {% if share >= 0.5 %}{% assign op = 1 %}{% elsif share >= 0.15 %}{% assign op = 0.8 %}{% elsif share >= 0.04 %}{% assign op = 0.6 %}{% else %}{% assign op = 0.45 %}{% endif %}
        .dotmap .c-{{ c.iso }} { fill: var(--pen); fill-opacity: {{ op }}; }
      {% endfor %}
    </style>

    <!-- version 1: dot map -->
    <figure class="dotmap">
      <svg
        viewBox="0 0 {{ dm.cols | times: 10 }} {{ dm.rows | times: 10 }}"
        role="img"
        aria-label="Dotted world map; countries with visitors are inked"
      >
        {% for d in dm.dots %}
          <circle cx="{{ d[0] | times: 10 | plus: 5 }}" cy="{{ d[1] | times: 10 | plus: 5 }}" r="3.1" class="c-{{ d[2] }}" />
        {% endfor %}
      </svg>
    </figure>

    <!-- version 2: flag counter -->
    <div class="flagc">
      <span class="tape" aria-hidden="true"></span>
      <div class="flagc-head mono">visitors</div>
      <ol class="flagc-list mono">
        {% for c in v.countries limit: 12 %}
          {% assign iso = c.iso | downcase %}
          <li>
            <img src="{{ '/assets/flags/' | append: iso | append: '.png' | relative_url }}" alt="" width="20" height="15" loading="lazy">
            <span class="cc">{{ c.iso }}</span>
            <span class="n">{{ c.count }}</span>
          </li>
        {% endfor %}
      </ol>
      <div class="flagc-foot mono">pageviews {{ v.total }} · flags collected {{ v.countries.size }}</div>
    </div>
    <p class="mono muted vfoot">updated {{ v.updated }}</p>
  {% endif %}
{% endif %}
