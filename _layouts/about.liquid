---
layout: default
---
<section class="hero">
  <div>
    <h1>
      {{ site.first_name }}
      {{ site.last_name }}
    </h1>
    {% if page.note %}
      <div class="note hand">
        <svg width="40" height="26" viewBox="0 0 40 26" aria-hidden="true">
          <path class="pen" d="M38 4 C 24 2, 10 8, 6 20 M6 20 l-3 -7 M6 20 l7 -3" />
        </svg>
        {{ page.note }}
      </div>
    {% endif %}
    <div class="theorem">
      {{ content }}
    </div>
  </div>
  {% if page.profile.image %}
    <div class="photo-col">
      {% assign attack = site.data.clip_attack %}
      <figure class="polaroid" id="polaroid">
        <span class="tape" aria-hidden="true"></span>
        <img
          id="attack-img"
          src="{{ '/assets/img/attack/beach-clean.jpg' | relative_url }}"
          alt="{{ site.first_name }} {{ site.last_name }}"
          width="900"
          height="900"
        >
        {% if page.profile.caption %}
          <figcaption>{{ page.profile.caption }}</figcaption>
        {% endif %}
      </figure>
      <div class="vlm">
        <p class="mono vlm-head">what CLIP thinks this is:</p>
        <ol class="bars mono" id="bars" aria-live="polite"></ol>
        <div class="tags" role="group" aria-label="Stick a name tag on the photo">
          <span class="hand">stick on a name tag:</span>
          {% for st in attack.stickers %}
            <button type="button" class="attack" data-key="{{ st[0] }}" aria-pressed="false">{{ st[1] }}</button>
          {% endfor %}
        </div>
        <p class="hand vlm-note" id="vlm-note" hidden>
          a name tag is enough to change what the model sees. this is a typographic attack, and it's part of what I study.
        </p>
        <p class="mono vlm-src">real {{ attack.model | remove: 'openai/' }} zero-shot scores over {{ attack.labels.size }} labels</p>
      </div>
      <script type="application/json" id="clip-data">
        {{ attack | jsonify }}
      </script>
    </div>
    <script src="{{ '/assets/notebook/vlm.js' | relative_url | bust_file_cache }}" defer></script>
  {% endif %}
</section>

{% if site.data.problems %}
  <h2 class="label">Open problems I'm working on</h2>
  <div class="problems">
    {% for p in site.data.problems %}
      <div class="problem">
        <div>
          <b>Problem 2.{{ forloop.index }}</b>
          {% if p.where -%}
            <i>({{ p.where }}).</i>
          {%- endif %}
          {{ p.question | markdownify | remove: '<p>' | remove: '</p>' | strip }}
        </div>
        <span class="stamp{% if p.done %} done{% endif %}">{{ p.status }}</span>
      </div>
    {% endfor %}
  </div>
{% endif %}

<h2 class="label">Sketchbook</h2>
<div class="sketch">
  {% for post in site.posts limit: 6 %}
    {% include nb/post_card.liquid post=post %}
  {% endfor %}
</div>
<a class="more" href="{{ '/blog/' | relative_url }}">the whole sketchbook →</a>

{% include nb/visitor_map.liquid %}
