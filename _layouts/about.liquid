---
layout: default
---
<section class="hero">
  <div>
    <h1>
      {{ site.first_name }}
      {{ site.last_name }}
    </h1>
    {% if page.note %}
      <div class="note hand">
        <svg width="40" height="26" viewBox="0 0 40 26" aria-hidden="true">
          <path class="pen" d="M38 4 C 24 2, 10 8, 6 20 M6 20 l-3 -7 M6 20 l7 -3" />
        </svg>
        {{ page.note }}
      </div>
    {% endif %}
    <div class="theorem">
      {{ content }}
    </div>
  </div>
  {% if page.profile.image %}
    <figure class="polaroid">
      <span class="tape" aria-hidden="true"></span>
      <picture>
        {% assign base = page.profile.image | prepend: 'assets/img/' | remove: '.jpg' | remove: '.png' %}
        <source srcset="{{ base | append: '-480.webp' | relative_url }}" type="image/webp">
        <img
          src="{{ page.profile.image | prepend: 'assets/img/' | relative_url }}"
          alt="{{ site.first_name }} {{ site.last_name }}"
          width="400"
          height="400"
        >
      </picture>
      {% if page.profile.caption %}
        <figcaption>{{ page.profile.caption }}</figcaption>
      {% endif %}
    </figure>
  {% endif %}
</section>

{% if site.data.problems %}
  <h2 class="label">Open problems I'm working on</h2>
  <div class="problems">
    {% for p in site.data.problems %}
      <div class="problem">
        <div>
          <b>Problem 2.{{ forloop.index }}</b>
          {% if p.where -%}
            <i>({{ p.where }}).</i>
          {%- endif %}
          {{ p.question | markdownify | remove: '<p>' | remove: '</p>' | strip }}
        </div>
        <span class="stamp{% if p.done %} done{% endif %}">{{ p.status }}</span>
      </div>
    {% endfor %}
  </div>
{% endif %}

<h2 class="label">Sketchbook</h2>
<div class="sketch">
  {% for post in site.posts limit: 6 %}
    {% include nb/post_card.liquid post=post %}
  {% endfor %}
</div>
<a class="more" href="{{ '/blog/' | relative_url }}">the whole sketchbook →</a>
