---
layout: default
---
<article>
  <header class="post-head">
    <h1>{{ page.title }}</h1>
    {% if page.description %}
      <p class="hand desc">{{ page.description }}</p>
    {% endif %}
    <p class="meta">
      {{ page.date | date: '%B %-d, %Y' | downcase }}
      {% assign words = content | number_of_words %}
      · {{ words | divided_by: 200 | plus: 1 }} min read
      {% for tag in page.tags %}
        {% unless tag == 'visual-proofs' %}· {{ tag }}{% endunless %}
      {% endfor %}
    </p>
  </header>
  <div class="post-body">
    {{ content }}
  </div>
  <p class="end" aria-hidden="true">∎</p>
</article>
<nav class="pager" aria-label="More posts">
  {% if page.previous %}
    <a href="{{ page.previous.url | relative_url }}"><span class="dir">← older</span>{{ page.previous.title }}</a>
  {% else %}
    <span></span>
  {% endif %}
  {% if page.next %}
    <a href="{{ page.next.url | relative_url }}" style="text-align: right"><span class="dir">newer →</span>{{ page.next.title }}</a>
  {% endif %}
</nav>
